# Node Environment & Server Port
NODE_ENV=development
PORT=5000

# Client Application URL (CORS Whitelist)
CLIENT_ORIGIN=http://localhost:3000

# Firebase Admin SDK Configuration
# Leave these blank until a real Firebase service account is configured.
# The app will run without Firestore if no credentials are supplied.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session Secret (Must be at least 32 characters for security)
SESSION_SECRET=mindbalance_default_session_secret_at_least_32_characters_long

# Private Journal Encryption Key (64 hex characters / 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional AI API Key (Leave empty to use deterministic CBT fallback)
AI_API_KEY=
AI_PROVIDER=google
